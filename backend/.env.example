# Anthropic API key. Copy this file to backend/.env and fill it in.
# .env is gitignored and must stay server-side (§3).
ANTHROPIC_API_KEY=

# Must support the web_search_20260209 / web_fetch_20260209 tools.
# Sonnet 5 is the default: same tools as Opus, materially cheaper for a loop
# that resends its conversation each iteration (§7).
ANTHROPIC_MODEL=claude-sonnet-5

# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
