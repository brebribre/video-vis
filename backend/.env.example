# Alibaba Cloud Model Studio (DashScope) credentials.
# Copy to backend/.env — .env is gitignored and must stay server-side (§3).
DASHSCOPE_API_KEY=

# Which DashScope region to talk to. Model availability differs between them (§1.2).
#   intl -> dashscope-intl.aliyuncs.com
#   cn   -> dashscope.aliyuncs.com
DASHSCOPE_REGION=intl

# Verify this model exists in the chosen region before relying on it.
DASHSCOPE_MODEL=qwen3.7-plus

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
